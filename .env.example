# Copy to `.env` to override defaults (all optional).
# Pydantic-settings reads this file; see backend/app/core/config.py.
# The signing secret is per-install (data/.secret_key) and only needs
# this when you want a fixed value (e.g. multi-process dev setups).
SECRET_KEY=
# True enables SQL echo and verbose logs. Never ship True.
DEBUG=false
# Override the SQLite location (default: data/masala_factory.db).
# DATABASE_URL=sqlite:///C:/data/masala_factory.db
# Comma-separated extra origins for a separate dev server. The desktop
# app only needs loopback 8000-8005, which are already allowed.
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
